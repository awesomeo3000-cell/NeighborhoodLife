+                    print("NLQA HOUSEHOLD RESULT: username=" .. tostring(key)
+                        .. " command=accept message=" .. tostring(message))
+                end
+                return
+            end
+        end
+    elseif command == "leave" then
+        if not household then message = "You are not in a household"
+        else
