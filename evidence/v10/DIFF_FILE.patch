+        self:drawText("LOOK "..i,28,y+10,0.12,0.38,0.63,1,UIFont.Small)
+        self:drawText(saved and (#saved.." saved pieces") or "Empty / save your current clothes",28,y+36,0.18,0.24,0.32,1,UIFont.Small)
