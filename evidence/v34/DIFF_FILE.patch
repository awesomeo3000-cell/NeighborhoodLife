+    button.backgroundColorMouseOver = { r = 0.69, g = 0.87, b = 0.98, a = 1 }
+    button.borderColor = { r = 0.53, g = 0.69, b = 0.82, a = 1 }
+    button.textColor = { r = 0.12, g = 0.30, b = 0.47, a = 1 }
+    button:initialise(); self:addChild(button)
